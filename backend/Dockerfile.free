# syntax=docker/dockerfile:1.7
# ==========================================================================
# DocShield backend — FREE-tier image (Render free web service: 512 MB, 0.1 CPU)
# Same FastAPI pipeline as backend/Dockerfile minus EasyOCR/PyTorch.
#   docker build -f backend/Dockerfile.free -t docshield-backend-free backend/
# ==========================================================================
FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-eng libglib2.0-0 libgomp1 libopenblas0-pthread \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
COPY requirements-free.txt /tmp/requirements-free.txt
RUN pip install -r /tmp/requirements-free.txt \
    && pip install --no-deps face-recognition==1.3.0 \
    && rm /tmp/requirements-free.txt

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    DOCSHIELD_ENV=production \
    DOCSHIELD_MODE=PROTOTYPE \
    PERSISTENCE_MODE=none \
    PRELOAD_MODELS=false \
    READY_REQUIRES=ocr_tesseract,face_detector,face_embedding,demo_registry \
    MAX_CONCURRENT_ANALYSIS=1 \
    MAX_IMAGE_PIXELS=10000000 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

WORKDIR /app
COPY --chown=root:root . /app/backend
RUN rm -rf /app/backend/tests /app/backend/data/*.db* \
    && python -c "import face_recognition, backend.services.face_service as f; assert f.face_service.net is not None and f.FACE_REC_AVAILABLE"

USER app
EXPOSE 8000

# Render injects PORT; queue waits inside the app are bounded (503 + Retry-After).
CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT} --workers 1 --no-server-header --timeout-graceful-shutdown 20 --limit-concurrency 8"]
