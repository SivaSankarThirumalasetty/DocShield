# DocShield Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Application Environment: development, staging, production
DOCSHIELD_ENV=development

# Server Binding
HOST=0.0.0.0
PORT=8000

# Operating Mode: DEMO, PROTOTYPE, OPERATIONAL
DOCSHIELD_MODE=PROTOTYPE

# Security & CORS
# Comma-separated list of allowed origins. Wildcards (*) with credentials are strictly forbidden.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Secret key required for officer endpoints (review, listing, audit)
DOCSHIELD_OFFICER_KEY=docshield-officer-secret-key-change-in-production

# Upload Restrictions
MAX_UPLOAD_SIZE_BYTES=10485760  # 10MB
MAX_IMAGE_PIXELS=10000000       # 10 megapixels (decompression bomb protection)
UPLOAD_TIMEOUT_SECONDS=30

# Concurrency & Rate Limiting (CPU Protection for Free/Budget Instances)
MAX_CONCURRENT_ANALYSIS=2        # Max concurrent CV/ML pipelines to prevent OOM
RATE_LIMIT_ANALYZE_PER_MINUTE=10 # Per-IP rate limit for /api/analyze-document

# Privacy & Image Retention Policy
# Ephemeral: Default false avoids saving raw identity images to disk
ENABLE_SOURCE_IMAGE_STORAGE=false
DATA_RETENTION_HOURS=24

# Persistence & Database
# Default: SQLite database inside data directory. Supports postgresql+asyncpg://... for production.
DATABASE_URL=sqlite:///./data/docshield.db

# Optional Tesseract OCR Binary Path (autodetected on Linux/Windows standard locations)
# TESSERACT_CMD=/usr/bin/tesseract

# Diagnostic & Debug Endpoint
# Set to true only in local development. Never enable in production.
ENABLE_DEBUG_ENDPOINT=false

