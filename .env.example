# ==============================================================================
# DocShield Environment Configuration (.env.example)
# Copy to .env for local execution. NEVER commit real .env files or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND VARIABLES (Cloudflare Workers / Vite Build)
# ------------------------------------------------------------------------------
# WARNING: Variables starting with VITE_ are bundled into public client assets.
# NEVER store private credentials, API keys, or officer secrets in VITE_* vars.

# Development: http://127.0.0.1:8000 (or empty for Vite dev proxy)
# Production (Cloudflare Worker & Container API): https://docshield.sivasankar-t1606.workers.dev
VITE_API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. PRIVATE BACKEND SECRETS & CONFIGURATION (FastAPI Python Container)
# ------------------------------------------------------------------------------
# Application Environment: development, staging, production
DOCSHIELD_ENV=development

# Operating Mode: DEMO, PROTOTYPE, OPERATIONAL
DOCSHIELD_MODE=PROTOTYPE

# Server Network Binding
HOST=0.0.0.0
PORT=8000

# Production Frontend Origin & CORS Whitelist (No wildcard '*' in production)
FRONTEND_ORIGIN=https://docshield.sivasankar-t1606.workers.dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://docshield.sivasankar-t1606.workers.dev,https://docshield.pages.dev
CORS_ORIGIN_REGEX=^https://([a-zA-Z0-9-]+\.)*docshield(-[a-zA-Z0-9-]+)?\.(pages|workers)\.dev$

# PRIVATE SECRET: Officer authorization key for case history & adjudication sign-off
DOCSHIELD_OFFICER_KEY=docshield-officer-secret-key-change-in-production

# Upload & Image Bomb Restrictions
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB
MAX_IMAGE_PIXELS=10000000       # 10 Megapixels (decompression bomb protection)
UPLOAD_TIMEOUT_SECONDS=30

# Concurrency & Rate Limiting (CPU & RAM Protection)
MAX_CONCURRENT_ANALYSIS=2        # Max concurrent CV/ML pipelines
RATE_LIMIT_ANALYZE_PER_MINUTE=10 # Per-IP sliding window limit (CF-Connecting-IP aware)

# Privacy & Image Retention Policy
ENABLE_SOURCE_IMAGE_STORAGE=false
DATA_RETENTION_HOURS=24

# Persistence & Database
# Default: SQLite with WAL mode inside backend/data/docshield.db
DATABASE_URL=sqlite:///./backend/data/docshield.db

# Optional Tesseract OCR Binary Path (auto-detected on Linux/Windows standard locations)
# TESSERACT_CMD=/usr/bin/tesseract

# Diagnostic Endpoint (Must remain false in production)
ENABLE_DEBUG_ENDPOINT=false
