# DocShield backend settings for LOCAL DEVELOPMENT ONLY (copy to .env).
# Placeholders only. Never commit a real .env. Production configuration lives in
# wrangler.jsonc (non-secret vars) and in the container image environment.

DOCSHIELD_ENV=development
DOCSHIELD_MODE=PROTOTYPE
PORT=8000

# "sqlite" stores redacted cases locally; the Cloudflare container uses "none"
# because the Worker stores redacted records in D1.
PERSISTENCE_MODE=sqlite
DATABASE_URL=sqlite:///./backend/data/docshield.db
DATA_RETENTION_HOURS=24

# Local-only reviewer key for the SQLite-mode reviewer endpoints. Leave empty to
# disable them. Production reviewers use per-person tokens (scripts/create-officer-token.mjs).
DOCSHIELD_OFFICER_KEY=

# Dev CORS (Vite on :5173). Production is same-origin and needs no CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload / resource limits
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_IMAGE_PIXELS=10000000
MAX_CONCURRENT_ANALYSIS=2
RATE_LIMIT_ANALYZE_PER_MINUTE=10

# Model loading
PRELOAD_MODELS=false
REQUIRE_FULL_PIPELINE=false
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
