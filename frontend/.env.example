# ============================================================================
# DocShield Frontend Environment Configuration (PUBLIC VITE VARIABLES)
# ============================================================================
# SECURITY WARNING:
# Any variable prefixed with VITE_ is embedded directly into the public
# JavaScript bundle sent to browsers.
# NEVER put private secrets, database URLs, or DOCSHIELD_OFFICER_KEY here!
# ============================================================================

# Local Development:
# Point to local FastAPI backend (or leave empty to use Vite dev proxy on port 5173 -> http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production (Cloudflare Pages):
# Set this in Cloudflare Pages -> Settings -> Environment Variables:
# VITE_API_BASE_URL=https://docshield-production.up.railway.app
